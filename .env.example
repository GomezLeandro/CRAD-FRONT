# Copiá este archivo a .env.local y completá con los valores de tu
# proyecto de Supabase (Settings → API).
#
# VITE_SUPABASE_ANON_KEY es la clave pública ("anon"): está diseñada
# para vivir en el frontend y quedar visible en el bundle de JS. NO es
# un secreto. La clave que SÍ es secreta es la "service_role key", que
# no debe existir en ningún archivo de este proyecto ni en el navegador
# (ver SECURITY.md).

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
